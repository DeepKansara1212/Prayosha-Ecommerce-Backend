# Server configuration
PORT=8000
NODE_ENV=development

# MongoDB (required)
MONGODB_URI=mongodb://localhost:27017/Prayosha-Ecommerce

# JWT (required; each should be at least 32 characters)
JWT_SECRET=change_me_to_a_secure_long_secret_min_32_chars
JWT_EXPIRY=15m
REFRESH_TOKEN_SECRET=change_me_to_a_secure_long_refresh_secret_min_32_chars
REFRESH_TOKEN_EXPIRY=7d

# Cloudinary (required)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend and Admin URLs
FRONTEND_URL=http://localhost:5174
ADMIN_URL=http://localhost:5173

# Razorpay (optional; app degrades gracefully without them)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (optional; order confirmation emails are skipped when missing)
EMAIL_USER=
EMAIL_PASS=

# MSG91 Flow API credentials (optional unless doing real OTP delivery)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Encryption key for provider credentials stored in the shipping_providers collection
# Must be at least 32 characters long
ENCRYPTION_KEY=replace_with_a_secure_random_32_plus_character_key

# Shipping webhook secrets (deployment-level shared credentials)
SHIPROCKET_WEBHOOK_TOKEN=
AFTERSHIP_WEBHOOK_SECRET=

# Location API (optional; has a working default if left blank)
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

# Temporary local testing override for AfterShip API calls
# Set to true to bypass live provider requests with mock data
AFTERSHIP_MOCK_MODE=false
